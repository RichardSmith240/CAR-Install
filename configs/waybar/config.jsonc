[{
	"include": ["module-configs/*.jsonc"],

	//location 
	"layer": "top",
	"output": "eDP-1",
	"position": "top", 
	
	//size
	//"height": 40,
	"spacing": 4, // Gaps between modules (4px)
	
	//module locations
	"modules-left": [
		 "hyprland/workspaces",
		 "pulseaudio"
	],
	"modules-center": [
	],
	"modules-right": [
		 "mpd",
		 "idle",
		 "network",
		 "keyboard-state",
		 "battery",
		 "clock",
		 "cpu",
		 "memory",
		 "tray",
		 "menu-power"
	]
}]
