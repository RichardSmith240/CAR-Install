[{
	"include": ["module-configs/*.jsonc"],
	//location 
	"layer": "top",
	"output": "eDP-1",
	"position": "top", 
	"tooltip": true,
	
	//size
	"spacing": 4, // Gaps between modules (4px)
	
	//module locations
	"modules-left": [
	  "hyprland/workspaces",
	  "pulseaudio",
	  "backlight"
	],

	"modules-center": [
	  "network",
	  "bluetooth"
	],

	"modules-right": [
	  "cpu",
	  "battery",
	  "clock"
	]

}]
