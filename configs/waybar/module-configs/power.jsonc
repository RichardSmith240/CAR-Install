{
	"battery": {
	  "interval": 60,
	  "states": {
		 "critical": 10,
		 "warning": 20,
		 "low": 30,
		 "full": 95
	  },

	  "format": "<span font='JetBrainsMono Nerd Font'>{icon}</span> {capacity}%",
	  "format-charging": "<span font='JetBrainsMono Nerd Font Mono'>󰂄</span> {capacity}%",
	  "format-plugged": "<span font='JetBrainsMono Nerd Font Mono'>󰚥</span> {capacity}%",
	  "format-full": "<span font='JetBrainsMono Nerd Font Mono'>󰁹</span>",

	  "format-icons": {
		 "empty": "󰁺",
		 "critical": "󰁻",
		 "low": "󰁼",
		 "warning": "󰁾",
		 "default": "󰁽",
		 "charging": "󰂄",
		 "plugged": "󰚥",
		 "full": "󰁹"
	  }
	},
	"power-profiles-daemon": {
	  "format": "{icon}",
	  "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
	  "tooltip": true,
	  "format-icons": {
		 "default": "",
		 "performance": "",
		 "balanced": "",
		 "power-saver": ""
	  }
	}
}
