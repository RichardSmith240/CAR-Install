{
	"clock": {
		"format": "{:%H:%M}",
		"tooltip": false
	},
	"cpu": {
		 "format": "{usage}% ",
		 "tooltip": false
	},
	"memory": {
		 "format": "{}% "
	},
	"temperature": {
		 // "thermal-zone": 2,
		 // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
		 "critical-threshold": 80,
		 "format": "{temperatureC}°C {icon}",
		 "format-icons": ["", "", ""]
	},
	"backlight": {
		 // "device": "acpi_video1",
		 "format": "{percent}% {icon}",
		 "format-icons": ["", "", "", "", "", "", "", "", ""]
	}
}
